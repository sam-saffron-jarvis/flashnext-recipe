#!/bin/sh
set -eu
exec 2>&1
export HOME=<home>
config=<state-dir>/root
if [ ! -s "$config" ]; then
    echo 'flashnext: not provisioned; waiting for explicit runtime adoption'
    exec sleep 60
fi
root=$(cat "$config")
cd /opt/flashnext-app
exec chpst -u <user> /opt/duplex-venv/bin/python -m flashnext.server --root "$root" --host 0.0.0.0 --idle 600
